snippet a-mdl_update "Update Method for Model"
public static function update(int \$id, array \$data)
{
    \$pdo = self::getDbConnection();
    \$columns = implode(", ", array_map(fn(\$key) => "\$key = :\$key", array_keys(\$data)));
    \$stmt = \$pdo->prepare("UPDATE ${1:table} SET \$columns WHERE id = :id");
    \$stmt->execute(array_merge(\$data, ['id' => \$id]));
    return \$stmt->rowCount() > 0;
}
endsnippet
snippet a-mdl_create "Create Method for Model"
public static function create(array \$data)
{
    \$pdo = self::getDbConnection();
    \$stmt = \$pdo->prepare("INSERT INTO ${1:table} (${2:columns}) VALUES (${3:placeholders})");
    \$stmt->execute(\$data);
    return ['id' => \$pdo->lastInsertId()] + \$data;
}
endsnippet
