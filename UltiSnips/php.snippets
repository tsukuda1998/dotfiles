snippet ctl_show "Show Method for Controller"
public function show(int $id)
{
    $item = ${1:Model}::find($id);
    if ($item) {
        echo json_encode($item);
    } else {
        http_response_code(404);
        echo json_encode(['error' => 'Resource not found.']);
    }
}
endsnippet

