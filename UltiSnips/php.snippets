snippet cfg_pdo "Standalone PDO Database Connection"
<?php
$host = '${1:localhost}';
$db   = '${2:}';
$user = '${3:}';
$pass = '${4:}';
$charset = 'utf8mb4';

$dsn = "mysql:host=$host;dbname=$db;charset=$charset";
$options = [
    PDO::ATTR_ERRMODE            => PDO::ERRMODE_EXCEPTION,
    PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
    PDO::ATTR_EMULATE_PREPARES   => false,
];

try {
    $pdo = new PDO($dsn, $user, $pass, $options);
} catch (\PDOException $e) {
    throw new \PDOException($e->getMessage(), (int)$e->getCode());
}
?>
endsnippet
snippet pdo_dev "PDO Database Connection (Development)" b
<?php

$host = getenv('DB_HOST') ?: 'localhost';
$db   = getenv('DB_DATABASE') ?: 'dev_database';
$user = getenv('DB_USERNAME') ?: 'dev_user';
$pass = getenv('DB_PASSWORD') ?: '';
$charset = 'utf8mb4';

$dsn = "mysql:host=$host;dbname=$db;charset=$charset";
$options = [
    PDO::ATTR_ERRMODE            => PDO::ERRMODE_EXCEPTION,
    PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
    PDO::ATTR_EMULATE_PREPARES   => false,
];

try {
    $pdo = new PDO($dsn, $user, $pass, $options);
    echo "開発用DB接続成功";
} catch (\PDOException $e) {
    echo "接続エラー: " . $e->getMessage();
}
?>
endsnippet

snippet rte_group "Route Group"
if (strpos($requestUri, '${1:/group}') === 0) {
    // Define grouped routes
    if ($requestUri === '${1:/group}/${2:subroute}' && $requestMethod === '${3:GET}') {
        $controller = new ${4:Controller}();
        $controller->${5:method}();
    }
}
endsnippet
snippet api_route "API Route Definition"
if ($requestUri === '${1:/endpoint}' && $requestMethod === '${2:GET}') {
    $controller = new App\Controllers\\${3:ControllerName}();
    $controller->${4:method}(${5});
}
endsnippet

snippet rte_middleware "Route with Middleware"
if (${1:condition}) {
    $middleware = new ${2:Middleware}();
    $middleware->handle($request, function ($request) use (${3:controller}) {
        $controller = new ${3:controller}();
        $controller->${4:method}();
    });
}
endsnippet
