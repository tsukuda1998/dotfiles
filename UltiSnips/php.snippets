snippet findAll "Find All Method for Model"
public function findAll(): array {
  $stmt = $this->db->prepare("SELECT * FROM {$this->table}");
  $stmt->execute();
  return $stmt->fetchAll(PDO::FETCH_ASSOC);
}
endsnippet

