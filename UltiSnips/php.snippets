snippet modelfunc "Base Method for Model"
public function ${1:method}(int $id): ${2:returnType} {
  $stmt = $this->db->prepare("${3:SQL Query}");
  $stmt->execute(${4:params});
  return ${5:result};
}
endsnippet

snippet delete "Delete Method for Model"
public function delete(int $id): bool {
  $stmt = $this->db->prepare("DELETE FROM {$this->table} WHERE id = :id");
  return $stmt->execute(['id' => $id]);
}
endsnippet

snippet mdl_updateOrCreate "Update or Create Method"
public static function updateOrCreate(array $conditions, array $data)
{
    $pdo = self::getDbConnection();
    $stmt = $pdo->prepare("SELECT * FROM ${1:table} WHERE ${2:conditions}");
    $stmt->execute($conditions);
    $existing = $stmt->fetch();

    if ($existing) {
        // Update existing
        self::update($existing['id'], $data);
    } else {
        // Create new
        self::create($data);
    }
}
endsnippet
snippet pdo_query_find "Fetch a Single Record"
public static function find(int $id): array | false
{
    $pdo = self::getDbConnection();
    $stmt = $pdo->prepare("SELECT * FROM ${1:table_name} WHERE id = :id");
    $stmt->execute(['id' => $id]);
    return $stmt->fetch(PDO::FETCH_ASSOC);
}
endsnippet

snippet pdo_connection "PDO Connection Setup"
private static function getDbConnection(): PDO
{
    $config = require __DIR__ . '/../../config/database.php';
    $pdo = new PDO($config['dsn'], $config['username'], $config['password']);
    $pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);
    return $pdo;
}
endsnippet

snippet mdl_find "Find Method for Model"
public function find(int $id): array | false {
  $stmt = $this->db->prepare("SELECT * FROM {$this->table} WHERE id = :id");
  $stmt->execute(['id' => $id]);
  return $stmt->fetch(PDO::FETCH_ASSOC);
}
endsnippet

