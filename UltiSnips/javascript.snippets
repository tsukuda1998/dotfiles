snippet function
function ${1:functionName}(${2:args}) {
  ${3:// body}
}
endsnippet

snippet const_arrow_function
const ${1:funcName} = (${2:args}) => {
  ${3:// body}
};
endsnippet

snippet document_queryselector
const ${1:element} = document.querySelector('${2:selector}');
endsnippet

snippet document_queryselectorall
const ${1:elements} = document.querySelectorAll('${2:selector}');
endsnippet

snippet element_addeventlistener
${1:element}.addEventListener('${2:event}', (${3:e}) => {
  ${4:// handle event}
});
endsnippet

snippet console_log
console.log(${1:variable});
endsnippet

snippet for_loop
for (let ${1:i} = 0; ${1} < ${2:array}.length; ${1}++) {
  ${3:// body}
}
endsnippet

snippet array_foreach
${1:array}.forEach(${2:item} => {
  ${3:// body}
});
endsnippet

snippet array_map
const ${1:result} = ${2:array}.map(${3:item} => {
  ${4:// transform item}
});
endsnippet

snippet array_filter
const ${1:result} = ${2:array}.filter(${3:item} => {
  return ${4:condition};
});
endsnippet

snippet array_reduce
const ${1:result} = ${2:array}.reduce((acc, ${3:item}) => {
  ${4:// operation}
  return acc;
}, ${5:initialValue});
endsnippet

snippet if_statement
if (${1:condition}) {
  ${2:// body}
}
endsnippet

snippet if_else_statement
if (${1:condition}) {
  ${2:// body}
} else {
  ${3:// else body}
}
endsnippet

snippet try_catch
try {
  ${1:// try block}
} catch (${2:error}) {
  ${3:console.error(${2});}
}
endsnippet

snippet fetch_api
fetch('${1:url}')
  .then(response => {
    if (!response.ok) {
      throw new Error('Network response was not ok');
    }
    return response.json();
  })
  .then(data => {
    ${2:// handle data}
  })
  .catch(error => {
    console.error('Fetch error:', error);
  });
endsnippet

