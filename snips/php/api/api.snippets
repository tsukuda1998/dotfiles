snippet header
header('${1}');
endsnippet

snippet header_Access-Control-Allow-Origin
header('Access-Control-Allow-Origin: http://localhost:${1}');
endsnippet

snippet requireDir
require __DIR__ . '${1}';
endsnippet

snippet vendor
vendor
endsnippet

snippet autoload
autoload
endsnippet

snippet Dotenv
Dotenv\\Dotenv;
\$dotenv = Dotenv::createImmutable(__DIR__ . '${1}');
\$dotenv->load();
endsnippet

snippet host_db_user_pass_charset
\$host = \$_ENV['DB_HOST'];
\$db = \$_ENV['DB_NAME'];
\$user = \$_ENV['DB_USER'];
\$pass = \$_ENV['DB_PASS'];
\$charset = \$_ENV['DB_CHARSET'];

\$dsn = "mysql:host=\$host;dbname=\$db;charset=\$charset";
endsnippet

snippet options
$options = [
    PDO::ATTR_ERRMODE            => PDO::ERRMODE_EXCEPTION,
    PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
    PDO::ATTR_EMULATE_PREPARES   => false,
];
endsnippet

snippet try_catch_pdo
try {
    \$pdo = new PDO(\$dsn, \$user, \$pass, \$options);
} catch (\\PDOException \$e) {
    echo json_encode(['error' => '${1}']);
    exit;
}
endsnippet

snippet stmt_pdo_query
\$stmt = \$pdo->query('${1}');
endsnippet

snippet stmt_fetchAll
\$stmt->fetchAll();
endsnippet

snippet json_encode
json_encode(${1}, JSON_UNESCAPED_UNICODE | JSON_PRETTY_PRINT);
endsnippet

