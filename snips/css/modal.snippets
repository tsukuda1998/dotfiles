snippet modal "Modal Component" b
.${1:modal} {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.5);
  justify-content: center;
  align-items: center;
}

.${1:modal}--${2:open} {
  display: flex;
}

.${1:modal}__${3:content} {
  background-color: ${4:#fff};
  padding: ${5:1.250rem};
  border-radius: ${6:0.500rem};
  width: ${7:80%};
  max-width: ${8:25.000rem};
}
endsnippet

