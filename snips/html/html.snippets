extends javascript

snippet html "HTML5 Boilerplate" b
<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>${1:Document}</title>
</head>
<body>
    ${0}
</body>
</html>
endsnippet

snippet flex-center "Tailwind: flex container & center all" b
class="flex items-center justify-center"
endsnippet

snippet flex-col "Tailwind: flex col" b
class="flex flex-col"
endsnippet

snippet grid-col-2 "Tailwind: grid with 2 columns" b
class="grid grid-cols-2 gap-4"
endsnippet

snippet grid-col-3 "Tailwind: grid with 3 columns" b
class="grid grid-cols-3 gap-4"
endsnippet

# --- Text & Font Size ---

snippet text-xl "Tailwind: text-xl" b
class="text-xl"
endsnippet

snippet text-2xl "Tailwind: text-2xl" b
class="text-2xl"
endsnippet

snippet text-custom "Tailwind: 任意のテキストサイズ (Arbitrary Value)" b
class="text-[$1px]"
endsnippet

# --- Font Weight ---

snippet font-bold "Tailwind: font-bold" b
class="font-bold"
endsnippet

snippet font-medium "Tailwind: font-medium" b
class="font-medium"
endsnippet

# --- Colors ---

snippet text-blue "Tailwind: text-blue-500" b
class="text-blue-500"
endsnippet

snippet bg-blue "Tailwind: bg-blue-500" b
class="bg-blue-500"
endsnippet

snippet text-gray "Tailwind: text-gray-700" b
class="text-gray-700"
endsnippet

snippet bg-gray "Tailwind: bg-gray-50" b
class="bg-gray-50"
endsnippet

# --- Margin & Padding ---

snippet m-4 "Tailwind: m-4 margin" b
class="m-4"
endsnippet

snippet p-4 "Tailwind: p-4 padding" b
class="p-4"
endsnippet

snippet px-4 "Tailwind: px-4 horizontal padding" b
class="px-4"
endsnippet

snippet py-4 "Tailwind: py-4 vertical padding" b
class="py-4"
endsnippet

# --- Hover ---

snippet hover-shadow "Tailwind: hover:shadow-lg" b
class="hover:shadow-lg"
endsnippet

snippet hover-bg "Tailwind: hover:bg-$1-500" b
class="hover:bg-${1|blue,red,green,gray|}-500"
endsnippet

# --- Rounded & Border ---

snippet rounded-md "Tailwind: rounded-md" b
class="rounded-md"
endsnippet

snippet border "Tailwind: border" b
class="border border-gray-300"
endsnippet

snippet hover-border "Tailwind: hover:border-$1-500" b
class="hover:border-${1|blue,red,green,gray|}-500"
endsnippet

# --- Shadows & Effects ---

snippet shadow "Tailwind: shadow-md" b
class="shadow-md"
endsnippet

snippet drop-shadow "Tailwind: drop-shadow" b
class="drop-shadow-$1"
endsnippet

snippet hover-drop-shadow "Tailwind: hover:drop-shadow" b
class="hover:drop-shadow-$1"
endsnippet


